; Minimal GROMACS test MDP for ChemCompute verification
integrator               = md
nsteps                   = 100
dt                       = 0.002
nstxout-compressed       = 10
nstlog                   = 10
cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 0.9
coulombtype              = Cut-off
rcoulomb                 = 0.9
vdw-type                 = Cut-off
rvdw                     = 0.9
pbc                      = xyz
tcoupl                   = no
pcoupl                   = no
gen-vel                  = yes
gen-temp                 = 300
gen-seed                 = 173520
